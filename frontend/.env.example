# Frontend Environment Variables
# For unified monorepo / Vercel Services deployment:
# Leave VITE_API_BASE_URL empty. The browser makes relative requests to '/api/*',
# which Vercel's top-level rewrites route directly to the backend service on the same domain.
VITE_API_BASE_URL=

# For separate backend deployments (e.g. standalone Render or remote VM):
# Set this to your deployed backend URL:
# VITE_API_BASE_URL=https://your-api-domain.com
